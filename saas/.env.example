# === MATMAT — variables d'environnement ===
# À renseigner dans Vercel (Settings > Environment Variables) ou dans un .env.local en local.
# Les variables préfixées VITE_ sont livrées AU NAVIGATEUR : n'y mettez jamais un secret.

# --- Clerk (authentification) ---
# Dashboard Clerk > API Keys. Créez une application DISTINCTE de celle du cockpit MITMIT :
# les comptes MATMAT n'ont rien à voir avec les comptes internes PEN'UP 3D.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_votre_cle_publique
CLERK_SECRET_KEY=sk_live_votre_cle_secrete

# --- Supabase (base multi-clients) ---
# Project Settings > API. La clé service_role contourne la RLS : elle reste côté serveur,
# et c'est la seule utilisée — le navigateur ne parle jamais directement à Postgres.
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# --- Stripe (abonnements) ---
# Dashboard Stripe > Developers > API keys, et > Products pour l'identifiant de tarif (price_...).
# Sans ces trois variables, l'application fonctionne mais l'écran Facturation reste inerte.
STRIPE_SECRET_KEY=sk_live_votre_cle_secrete
STRIPE_PRICE_ID=price_votre_tarif_mensuel
# Dashboard Stripe > Developers > Webhooks > votre endpoint > Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_votre_secret_de_signature

# --- URL publique ---
# Sert aux URL de retour après paiement. Si absente, elle est déduite de la requête —
# ce qui convient en préversion, mais fixez-la en production pour éviter toute surprise.
APP_URL=https://matmat.vercel.app
